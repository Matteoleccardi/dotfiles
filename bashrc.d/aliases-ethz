# --- Cisco Secure Client (ETHZ VPN) Aliases ---
# Check if the Cisco Secure Client directory exists before defining aliases.
if [ -d "/opt/cisco/secureclient/" ]; then
    alias vpn-eth="/opt/cisco/secureclient/bin/vpn"
    alias vpn-eth-connect="vpn-eth connect sslvpn.ethz.ch/staff-net"
else
    # Optional: You can uncomment the line below if you want a message
    : # 'no-op' command to keep the else block valid if no message is needed
fi

# starthcatsegment
HOST=$(hostname | tr '[:upper:]' '[:lower:]')
case "$HOST" in
    # 1. Substring matches using a pattern with wildcards (*)
    "magnum"|*octopus*|*bmic*|*biwi*)
        # This single pattern matches if 'octopus', 'bmic', or 'biwi' is anywhere in the hostname
        alias starthcatsegment="conda activate hcatsegment && cd /scratch_net/magnum/mleccardi/Repos/HCATSegment/"
        ;; # End of case pattern 2

    # Fallback for all other hostnames
    *)
        ;; # End of default case
esac
unset $HOST

# SQLite
export LD_LIBRARY_PATH="/scratch/mleccardi/.local/sqlite/lib:$LD_LIBRARY_PATH"

# SLURM at ETHZ - CVL
export SLURM_CONF="/home/sladmcvl/slurm/slurm.conf"

alias ssmon="smon | GREP_COLOR='01;32' grep --color=always -E 'free|$' | GREP_COLOR='01;33' grep --color=always -E '${USER}|$'"
alias sssmon="smon | grep mlec"

alias ssqueue="squeue | GREP_COLOR='01;33' grep --color=always -E 'Resources|Priority|$' | GREP_COLOR='01;32' grep --color=always -E 'mleccard|$'"
alias sssqueue="ssqueue | grep mlec"

# For python pip to not clog /home/mleccardi on "magnum" machine at ETHZ - CVL
export TMPDIR="/scratch_net/magnum/mleccardi/.tmp"

# Projects
alias starthcatsegment='cd /scratch_net/magnum/mleccardi/Repo/HCATSegment; conda activate hcatsegment'

