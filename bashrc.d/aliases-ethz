# ~/.bashrc.d/aliases-ethz
#
# ETH-only aliases and functions. Sourced automatically by ~/.bashrc (files WITHOUT a dot in their name).
# On any machine that is not an ETH one this file defines NOTHING (apart from the VPN alias, which lives on the
# laptop and is guarded by the presence of the Cisco client).
#
# ETH machines are recognised by hostname: hades (login node), octopus* (GPU nodes), bmic*, biwi*
# (+ anything under *.ee.ethz.ch, which covers hades.ee.ethz.ch and the other D-ITET hosts).

# ===== 1. ETH VPN (laptop side): only if the Cisco Secure Client is installed =====
if [ -d "/opt/cisco/secureclient/" ]; then
    alias vpn-eth="/opt/cisco/secureclient/bin/vpn"
    alias vpn-eth-connect="vpn-eth connect sslvpn.ethz.ch/staff-net"
fi

# ===== 2. Everything below exists ONLY on ETH machines =====
_ethz_host="$(hostname 2>/dev/null | tr '[:upper:]' '[:lower:]')"
_ethz_fqdn="$(hostname -f 2>/dev/null | tr '[:upper:]' '[:lower:]')"
_ethz_ok=0
case "$_ethz_host" in
    hades*|*octopus*|*bmic*|*biwi*) _ethz_ok=1 ;;
esac
case "$_ethz_fqdn" in
    *.ee.ethz.ch|*.ethz.ch) _ethz_ok=1 ;;
esac
unset _ethz_host _ethz_fqdn
if [ "$_ethz_ok" != 1 ]; then
    unset _ethz_ok
    return 0 2>/dev/null || exit 0      # sourced: stop here; executed: exit
fi
unset _ethz_ok

# --- project: HCATSegment -----------------------------------------------------------------------------------
alias starthcatsegment="conda activate hcatsegment && cd ~/Repos/HCATSegment/"

# --- SQLite (local build in bhome) --------------------------------------------------------------------------
# (the old line used "~" inside quotes, which bash does NOT expand: it put a literal '~' in the path)
if [ -d "$HOME/bhome/.local/sqlite/lib" ]; then
    export LD_LIBRARY_PATH="$HOME/bhome/.local/sqlite/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# SLURM at ETHZ - CVL: already set system-wide on hades/octopus, so only set it if it is missing
# (from the old file; the old TMPDIR on "magnum" is gone: TMPDIR is defined elsewhere)
if [ -z "$SLURM_CONF" ] && [ -r /home/sladmcvl/slurm/slurm.conf ]; then
    export SLURM_CONF="/home/sladmcvl/slurm/slurm.conf"
fi

# --- Pretty monitors (blue = free / Resources, yellow = you) ------------------------------------------------
# squeue truncates user names to 8 characters in its default format, hence ${USER:0:8}
unalias ssmon 2>/dev/null
ssmon() {
    smon | USER8="${USER:0:8}" perl -pe '
        BEGIN { $u = $ENV{USER8}; }
        s/(free)/\e[01;34m$1\e[0m/g;
        s/($u)/\e[01;33m$1\e[0m/g;
        s/(username)/\e[01;33m$1\e[0m/g;
    '
}
alias sssmon='ssmon | grep "${USER:0:8}"'

unalias ssqueue 2>/dev/null
ssqueue() {
    squeue | USER8="${USER:0:8}" perl -pe '
        BEGIN { $u = $ENV{USER8}; }
        s/(Resources)/\e[01;34m$1\e[0m/g;
        s/($u)/\e[01;33m$1\e[0m/g;
    '
}
alias sssqueue='ssqueue | grep "${USER:0:8}"'

# My running jobs with the folder that contains their "*<jobid>*.sbatch_id" marker file (searched below the current dir)
unalias asqueue 2>/dev/null
asqueue() {
    local job id etime a folder
    for job in $(squeue --me -o "%A§%M" --noheader); do
        id="${job%%§*}"      # everything before §  (job id)
        etime="${job#*§}"    # everything after §   (elapsed time)
        a=$(find . -type f -name "*$id*.sbatch_id" -print -quit)
        if [ -n "$a" ]; then
            folder=$(basename "$(dirname "$a")")
        else
            folder="( NONE )"
        fi
        printf "%s§%s§%s\n" "$etime" "$id" "$folder"
    done | column -t -s '§'
}

# ===== 3. Interactive Slurm sessions (hades -> octopus nodes) =====================================================
# - The cluster's job_submit.lua IGNORES -p/--partition (it routes you by account), so no -p here.
# - Interactive jobs are capped at 120 min (--time is in minutes).
# - CPU-only jobs MUST pass --gres=gpu:0, otherwise the cluster silently adds a GPU.
# - Never run GPU work on the login node (hades): start one of these first.
# - The RAM you ask for decides how long you wait (octopus03/04 are nearly full in memory): keep the *_big ones for when needed.
alias srun_cpu="srun --gres=gpu:0 --cpus-per-task=4 --mem=16G --time=120 --pty bash -i"
alias srun_cpu_big="srun --gres=gpu:0 --cpus-per-task=16 --mem=128G --time=120 --pty bash -i"
alias srun_gpu="srun --gres=gpu:a6000:1 --cpus-per-task=8 --mem=64G --time=120 --pty bash -i"
alias srun_gpu_big="srun --gres=gpu:a6000:1 --cpus-per-task=24 --mem=180G --time=120 --pty bash -i"
alias srun_gpu2="srun --gres=gpu:a6000:2 --cpus-per-task=16 --mem=128G --time=120 --pty bash -i"
alias sq='squeue -u $USER -o "%.10i %.9P %.12j %.8T %.10M %.10l %.6D %R"'

# Attach a new terminal to an existing job allocation (job id optional: takes your latest running job)
srun_attach() {
    local job_id="$1"
    if [[ "$job_id" == "-h" || "$job_id" == "--help" ]]; then
        echo "Usage: srun_attach [job_id]     (extra CPUs for the new shell: SRUN_ATTACH_CPUS=4 srun_attach)"
        echo "Find your job id:  squeue -u \$USER     or, inside the job:  echo \$SLURM_JOB_ID"
        return 0
    fi
    if [ -z "$job_id" ]; then
        job_id=$(squeue -h -u "$USER" -t RUNNING -o "%A" | tail -n 1)
        if [ -z "$job_id" ]; then
            echo "Error: no running job found for '$USER'. Check with: squeue -u $USER"
            return 1
        fi
        echo "Found running job $job_id on $(squeue -h -j "$job_id" -o %N)"
    fi
    echo "Connecting a new bash session to job $job_id ..."
    srun --jobid="$job_id" --overlap -n 1 --cpus-per-task="${SRUN_ATTACH_CPUS:-2}" --pty bash -i
}

# Free GPUs per octopus node (with the 'student' account only octopus03/04 are reachable at the moment)
gpu_free() {
    local n
    for n in octopus01 octopus02 octopus03 octopus04; do
        scontrol show node "$n" 2>/dev/null | awk -v n="$n" '
            /CfgTRES=/   { if (match($0, /gres\/gpu=[0-9]+/)) cfg = substr($0, RSTART+9, RLENGTH-9) }
            /AllocTRES=/ { if (match($0, /gres\/gpu=[0-9]+/)) al = substr($0, RSTART+9, RLENGTH-9) }
            END { printf "%s: %d of %d GPUs free\n", n, cfg-al, cfg }'
    done
}

alias srun_show_options='echo "srun_cpu | srun_cpu_big | srun_gpu | srun_gpu_big | srun_gpu2 | srun_attach [jobid] | sq | gpu_free | ssmon | ssqueue | asqueue | scratch_info | scratch_init | scratch_path | scratch_stage SRC [SUBDIR] | scratch_check_all"'

# ===== 4. Node-local NVMe scratch (compute nodes only) =============================================================
# Every compute node has its OWN local SSD mounted at /scratch (octopus04: 1.7 TB NVMe, measured ~3-4 GB/s against ~0.3-0.6 GB/s on
# the NFS where the datasets, caches and TMPDIR live). Facts (checked on octopus04, 2026-11-05):
#   - it is LOCAL to the node: not visible from hades, nor from another node (copy again at the start of every job);
#   - it is SHARED by all users (/scratch is world-writable; everybody works in /scratch/<user>);
#   - ISG's scratch_clean (cron, minute 36) deletes only when free space falls below ~10%: oldest / biggest files of the heaviest
#     users first, so treat it as a fast CACHE, never as the only copy of anything;
#   - the sbatch jobs (and the prolog) do not create anything there for you: do it yourself, e.g. with scratch_init / scratch_stage.
# NODE_SCRATCH is defined only where a writable /scratch exists (so not on hades).
if [ -d /scratch ] && [ -w /scratch ]; then
    export NODE_SCRATCH="/scratch/$USER"
fi

scratch_path() {   # print the path, usable as: cd "$(scratch_path)"
    echo "${NODE_SCRATCH:-/scratch/$USER}"
}

scratch_init() {   # create the standard folders (idempotent)
    if [ -z "$NODE_SCRATCH" ]; then
        echo "No local /scratch on $(hostname) (login node?). Start a job first: srun_cpu / srun_gpu"
        return 1
    fi
    ( umask 077; mkdir -p "$NODE_SCRATCH"/{data,cache,tmp} ) && echo "$NODE_SCRATCH ready: data/  cache/  tmp/"
}

scratch_info() {   # node, free space, my usage
    if [ ! -d /scratch ]; then
        echo "No local /scratch on $(hostname) (login node?)."
        return 1
    fi
    echo "node: $(hostname)   my path: ${NODE_SCRATCH:-/scratch/$USER}"
    df -h /scratch | awk 'NR==2 {printf "disk /scratch: %s total, %s used, %s free (%s used)\n", $2, $3, $4, $5}'
    [ -d "$NODE_SCRATCH" ] && echo "mine: $(du -sh "$NODE_SCRATCH" 2>/dev/null | cut -f1) in $NODE_SCRATCH"
    echo "reminder: local to this node, shared with other users, cleaned only when free space < 10% (oldest/biggest first)"
}

# Copy something to the local scratch (rsync: resumable, skips what is already there).
#   scratch_stage /path/to/dir_or_file [subdir]     (default subdir: data)  ->  $NODE_SCRATCH/<subdir>/
scratch_stage() {
    local src="$1" sub="${2:-data}"
    if [ -z "$src" ] || [ -z "$NODE_SCRATCH" ]; then
        echo "Usage: scratch_stage SRC [SUBDIR]   (needs a local /scratch: run it inside a job)"
        return 1
    fi
    scratch_init > /dev/null || return 1
    echo "source size: $(du -sh "$src" 2>/dev/null | cut -f1)   free on /scratch: $(df -h --output=avail /scratch | tail -1 | tr -d ' ')"
    rsync -a --info=progress2 "$src" "$NODE_SCRATCH/$sub/" && echo "staged in $NODE_SCRATCH/$sub/"
}

# Space on every octopus node (opens a tiny 2-minute job step per node; with the 'student' account only the nodes your jobs
# are routed to answer, the others give up after 60 s)
scratch_check_all() {
    local n
    for n in octopus01 octopus02 octopus03 octopus04; do
        echo "=== $n ==="
        srun --immediate=60 --nodelist="$n" --gres=gpu:0 --mem=2G --cpus-per-task=1 --time=2 \
            bash -c 'df -h /scratch | tail -1; du -sh /scratch/$USER 2>/dev/null' 2>&1 | tail -3
    done
}

