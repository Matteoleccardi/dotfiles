if command -v fzf &>/dev/null; then
  #
  
  if command -v bat &>/dev/null; then
    export FZF_DEFAULT_OPTS="--preview 'bat --style=plain --color=always {}' --preview-window up,40%"
  fi

  #
  
  if command -v fd &>/dev/null; then
    # We use $git_root here, which will be captured dynamically when fzf runs
    cmd_git='fd . "$git_root" --type f --hidden --follow --exclude .git --exclude node_modules --exclude __pycache__'
    cmd_nogit='fd . --type f --hidden --follow'
  else
    # find commands: pass "$git_root" instead of "."
    cmd_git='find -L "$git_root" \( -name ".git" -o -name "node_modules" -o -name "__pycache__" \) -prune -o -type f -print'
    cmd_nogit='find -L . -type f'
  fi
  # ( we use double quotes to inject the variables above NOW, but we ESCAPE the $ in \$(git...) so it evaluates LATER (when fzf actually runs) ).
  # We check for the git root and assign it to $git_root. 
  # We use 'eval' so the commands above can safely read the $git_root variable.
  export FZF_DEFAULT_COMMAND="if git_root=\$(git rev-parse --show-toplevel 2>/dev/null); then eval '$cmd_git'; else eval '$cmd_nogit'; fi"
    
  
  # use **<TAB> for autocompleting using fzf in the terminal
  if fzf --bash >/dev/null 2>&1; then
    eval "$(fzf --bash)"
    export FZF_COMPLETION_TRIGGER='**'
  fi

fi
