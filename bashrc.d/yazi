# yazi terminal file explorer

# in yazi, when navigating folders, if click 'o' on a folder
# when opening yazi with 'y', exit yazi and move to that folder 
# in the current terminal

function y() {
    # Check if yazi is installed in the system PATH
    if ! command -v yazi >/dev/null 2>&1; then
        echo "(yazi not installed, please go to https://yazi-rust.github.io/)"
        return 1
    fi

    # Main logic
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	export YAZI_CWD_FILE="$tmp"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
	unset YAZI_CWD_FILE
}
